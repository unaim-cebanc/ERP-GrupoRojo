-- ==========================================================
-- 6. VISTAS
-- ==========================================================

-- Embudo de ventas por etapa (importe_ponderado = importe x probabilidad)
CREATE OR REPLACE DEFINER = 'root'@'localhost' SQL SECURITY DEFINER VIEW v_pipeline_crm AS
SELECT etapa,
       COUNT(*)                                          AS num_oportunidades,
       SUM(importe_estimado)                             AS importe_total,
       ROUND(SUM(importe_estimado * probabilidad / 100), 2) AS importe_ponderado
  FROM oportunidades
 GROUP BY etapa;

-- Presupuestos con su total sin IVA
CREATE OR REPLACE DEFINER = 'root'@'localhost' SQL SECURITY DEFINER VIEW v_presupuestos_resumen AS
SELECT p.id AS presupuesto_id,
       c.nombre AS cliente,
       p.estado,
       p.fecha,
       p.fecha_validez,
       COALESCE((SELECT ROUND(SUM(l.cantidad * l.precio_unitario * (1 - l.descuento_pct / 100)), 2)
                   FROM lineas_presupuesto l
                  WHERE l.presupuesto_id = p.id), 0) AS total_sin_iva
  FROM presupuestos p
  JOIN clientes c ON c.id = p.cliente_id;


