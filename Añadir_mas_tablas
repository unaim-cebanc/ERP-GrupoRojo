USE decasport;

-- ==========================================================
-- 1. OPORTUNIDADES (CRM)
-- Embudo comercial: cada oportunidad pertenece a un cliente
-- y avanza por etapas hasta ganarse o perderse.
-- ==========================================================

CREATE TABLE oportunidades (
    id                    INT UNSIGNED  NOT NULL AUTO_INCREMENT,
    cliente_id            INT UNSIGNED  NOT NULL,
    titulo                VARCHAR(150)  NOT NULL,
    importe_estimado      DECIMAL(12,2) NOT NULL DEFAULT 0,
    probabilidad          TINYINT UNSIGNED NOT NULL DEFAULT 10,
    etapa                 ENUM(
                              'prospecto',
                              'propuesta',
                              'negociacion',
                              'ganada',
                              'perdida'
                          ) NOT NULL DEFAULT 'prospecto',
    fecha_creacion        DATE          NOT NULL DEFAULT (CURRENT_DATE),
    fecha_cierre_prevista DATE          NULL,
    fecha_cierre          DATE          NULL,

    PRIMARY KEY (id),

    CONSTRAINT fk_oportunidades_cliente
        FOREIGN KEY (cliente_id)
        REFERENCES clientes (id),

    CONSTRAINT ck_oportunidades_importe
        CHECK (importe_estimado >= 0),

    CONSTRAINT ck_oportunidades_probabilidad
        CHECK (probabilidad <= 100),

    CONSTRAINT ck_oportunidades_cierre_etapa
        CHECK (
            (etapa IN ('ganada','perdida') AND fecha_cierre IS NOT NULL)
            OR
            (etapa NOT IN ('ganada','perdida') AND fecha_cierre IS NULL)
        )
) ENGINE=InnoDB;


-- ==========================================================
-- 2. PRESUPUESTOS
-- Cabecera de la oferta enviada a un cliente.
-- Puede venir de una oportunidad y, si se acepta, se enlaza
-- con el pedido de venta que genera (pedido_id).
-- ==========================================================

CREATE TABLE presupuestos (
    id             INT UNSIGNED NOT NULL AUTO_INCREMENT,
    cliente_id     INT UNSIGNED NOT NULL,
    oportunidad_id INT UNSIGNED NULL,
    pedido_id      INT UNSIGNED NULL,
    fecha          DATETIME     NOT NULL DEFAULT CURRENT_TIMESTAMP,
    fecha_validez  DATE         NOT NULL,
    estado         ENUM(
                       'borrador',
                       'enviado',
                       'aceptado',
                       'rechazado',
                       'caducado'
                   ) NOT NULL DEFAULT 'borrador',
    observaciones  VARCHAR(500) NULL,

    PRIMARY KEY (id),

    UNIQUE KEY uq_presupuestos_pedido (pedido_id),

    CONSTRAINT fk_presupuestos_cliente
        FOREIGN KEY (cliente_id)
        REFERENCES clientes (id),

    CONSTRAINT fk_presupuestos_oportunidad
        FOREIGN KEY (oportunidad_id)
        REFERENCES oportunidades (id),

    CONSTRAINT fk_presupuestos_pedido
        FOREIGN KEY (pedido_id)
        REFERENCES pedidos (id),

    CONSTRAINT ck_presupuestos_validez
        CHECK (fecha_validez >= DATE(fecha))
) ENGINE=InnoDB;


-- ==========================================================
-- 3. LÍNEAS DE PRESUPUESTO
-- Detalle de productos, cantidades, precio ofertado y descuento.
-- ==========================================================

CREATE TABLE lineas_presupuesto (
    id              INT UNSIGNED  NOT NULL AUTO_INCREMENT,
    presupuesto_id  INT UNSIGNED  NOT NULL,
    producto_id     INT UNSIGNED  NOT NULL,
    cantidad        INT           NOT NULL,
    precio_unitario DECIMAL(10,2) NOT NULL,
    descuento_pct   DECIMAL(5,2)  NOT NULL DEFAULT 0,

    PRIMARY KEY (id),

    UNIQUE KEY uq_lineas_presupuesto_producto (
        presupuesto_id,
        producto_id
    ),

    CONSTRAINT fk_lineas_presupuesto_presupuesto
        FOREIGN KEY (presupuesto_id)
        REFERENCES presupuestos (id),

    CONSTRAINT fk_lineas_presupuesto_producto
        FOREIGN KEY (producto_id)
        REFERENCES productos (id),

    CONSTRAINT ck_lineas_presupuesto_cantidad
        CHECK (cantidad > 0),

    CONSTRAINT ck_lineas_presupuesto_precio
        CHECK (precio_unitario >= 0),

    CONSTRAINT ck_lineas_presupuesto_descuento
        CHECK (descuento_pct BETWEEN 0 AND 100)
) ENGINE=InnoDB;


-- ==========================================================
-- 4. CRM: enlazar las interacciones existentes con oportunidades
-- La columna es opcional (NULL = contacto suelto sin oportunidad).
-- ==========================================================

ALTER TABLE interacciones
    ADD COLUMN oportunidad_id INT UNSIGNED NULL AFTER cliente_id,
    ADD CONSTRAINT fk_interacciones_oportunidad
        FOREIGN KEY (oportunidad_id)
        REFERENCES oportunidades (id);


