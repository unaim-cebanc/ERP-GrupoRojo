CREATE DATABASE IF NOT EXISTS decasport
  CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
USE decasport;

-- =====================================================================
-- 1. TABLAS
-- =====================================================================

CREATE TABLE proveedores (
  id     INT UNSIGNED NOT NULL AUTO_INCREMENT,
  nombre VARCHAR(100) NOT NULL,
  email  VARCHAR(120) NOT NULL,
  pais   CHAR(2)      NOT NULL,
  PRIMARY KEY (id),
  UNIQUE KEY uq_proveedores_email (email)
) ENGINE=InnoDB;

CREATE TABLE productos (
  id           INT UNSIGNED  NOT NULL AUTO_INCREMENT,
  sku          VARCHAR(20)   NOT NULL,
  nombre       VARCHAR(120)  NOT NULL,
  categoria    VARCHAR(40)   NOT NULL,
  precio       DECIMAL(10,2) NOT NULL,
  stock        INT           NOT NULL DEFAULT 0,
  proveedor_id INT UNSIGNED  NOT NULL,
  PRIMARY KEY (id),
  UNIQUE KEY uq_productos_sku (sku),
  CONSTRAINT fk_productos_proveedor FOREIGN KEY (proveedor_id) REFERENCES proveedores (id),
  CONSTRAINT ck_productos_precio CHECK (precio >= 0),
  CONSTRAINT ck_productos_stock  CHECK (stock >= 0)
) ENGINE=InnoDB;

CREATE TABLE clientes (
  id     INT UNSIGNED NOT NULL AUTO_INCREMENT,
  nombre VARCHAR(120) NOT NULL,
  email  VARCHAR(120) NOT NULL,
  ciudad VARCHAR(60)  NULL,
  pais   CHAR(2)      NOT NULL,
  PRIMARY KEY (id),
  UNIQUE KEY uq_clientes_email (email)
) ENGINE=InnoDB;

-- CRM: seguimiento de contactos con cada cliente
CREATE TABLE interacciones (
  id         INT UNSIGNED NOT NULL AUTO_INCREMENT,
  cliente_id INT UNSIGNED NOT NULL,
  tipo       ENUM('llamada','email','reunion') NOT NULL,
  nota       VARCHAR(255) NOT NULL,
  fecha      DATETIME     NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  CONSTRAINT fk_interacciones_cliente FOREIGN KEY (cliente_id) REFERENCES clientes (id)
) ENGINE=InnoDB;

CREATE TABLE pedidos (
  id         INT UNSIGNED NOT NULL AUTO_INCREMENT,
  cliente_id INT UNSIGNED NOT NULL,
  fecha      DATETIME     NOT NULL DEFAULT CURRENT_TIMESTAMP,
  estado     ENUM('pendiente','facturado') NOT NULL DEFAULT 'pendiente',
  PRIMARY KEY (id),
  CONSTRAINT fk_pedidos_cliente FOREIGN KEY (cliente_id) REFERENCES clientes (id)
) ENGINE=InnoDB;

CREATE TABLE lineas_pedido (
  id              INT UNSIGNED  NOT NULL AUTO_INCREMENT,
  pedido_id       INT UNSIGNED  NOT NULL,
  producto_id     INT UNSIGNED  NOT NULL,
  cantidad        INT           NOT NULL,
  precio_unitario DECIMAL(10,2) NOT NULL DEFAULT 0,   -- lo rellena el trigger con el precio del producto
  PRIMARY KEY (id),
  UNIQUE KEY uq_linea_producto (pedido_id, producto_id),
  CONSTRAINT fk_lineas_pedido   FOREIGN KEY (pedido_id)   REFERENCES pedidos (id) ON DELETE CASCADE,
  CONSTRAINT fk_lineas_producto FOREIGN KEY (producto_id) REFERENCES productos (id),
  CONSTRAINT ck_lineas_cantidad CHECK (cantidad > 0)
) ENGINE=InnoDB;

CREATE TABLE facturas (
  id        INT UNSIGNED  NOT NULL AUTO_INCREMENT,   -- el id hace de número de factura
  pedido_id INT UNSIGNED  NOT NULL,
  fecha     DATETIME      NOT NULL DEFAULT CURRENT_TIMESTAMP,
  base      DECIMAL(12,2) NOT NULL,
  iva       DECIMAL(12,2) NOT NULL,
  total     DECIMAL(12,2) NOT NULL,
  PRIMARY KEY (id),
  UNIQUE KEY uq_facturas_pedido (pedido_id),
  CONSTRAINT fk_facturas_pedido FOREIGN KEY (pedido_id) REFERENCES pedidos (id),
  CONSTRAINT ck_facturas_total CHECK (total = base + iva)
) ENGINE=InnoDB;


-- =====================================================================
-- 2. FUNCIÓN
-- =====================================================================
DELIMITER $$

-- Total (sin IVA) de un pedido
CREATE DEFINER = 'root'@'localhost' FUNCTION fn_total_pedido(p_pedido_id INT)
RETURNS DECIMAL(12,2)
READS SQL DATA
BEGIN
  DECLARE v_total DECIMAL(12,2);
  SELECT COALESCE(SUM(cantidad * precio_unitario), 0) INTO v_total
    FROM lineas_pedido
   WHERE pedido_id = p_pedido_id;
  RETURN v_total;
END$$

DELIMITER ;


-- =====================================================================
-- 3. PROCEDIMIENTOS ALMACENADOS
-- =====================================================================
DELIMITER $$

-- Crea un pedido vacío para un cliente y devuelve su id
CREATE DEFINER = 'root'@'localhost' PROCEDURE sp_crear_pedido(
  IN  p_cliente_id INT,
  OUT p_pedido_id  INT)
BEGIN
  INSERT INTO pedidos (cliente_id) VALUES (p_cliente_id);
  SET p_pedido_id = LAST_INSERT_ID();
END$$

-- Factura un pedido pendiente (IVA 21 %) y lo marca como facturado
CREATE DEFINER = 'root'@'localhost' PROCEDURE sp_facturar_pedido(
  IN  p_pedido_id  INT,
  OUT p_factura_id INT)
BEGIN
  DECLARE v_base DECIMAL(12,2);
  DECLARE v_iva  DECIMAL(12,2);
  DECLARE EXIT HANDLER FOR SQLEXCEPTION
  BEGIN
    ROLLBACK;
    RESIGNAL;
  END;

  IF NOT EXISTS (SELECT 1 FROM pedidos WHERE id = p_pedido_id AND estado = 'pendiente') THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'El pedido no existe o ya esta facturado';
  END IF;

  SET v_base = fn_total_pedido(p_pedido_id);
  IF v_base = 0 THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'El pedido no tiene lineas';
  END IF;
  SET v_iva = ROUND(v_base * 0.21, 2);

  START TRANSACTION;
  INSERT INTO facturas (pedido_id, base, iva, total)
  VALUES (p_pedido_id, v_base, v_iva, v_base + v_iva);
  SET p_factura_id = LAST_INSERT_ID();
  UPDATE pedidos SET estado = 'facturado' WHERE id = p_pedido_id;
  COMMIT;
END$$

DELIMITER ;


-- =====================================================================
-- 4. VISTAS
-- =====================================================================

CREATE OR REPLACE DEFINER = 'root'@'localhost' SQL SECURITY DEFINER VIEW v_pedidos_resumen AS
SELECT p.id AS pedido_id,
       p.fecha,
       c.nombre AS cliente,
       p.estado,
       fn_total_pedido(p.id) AS total_sin_iva
  FROM pedidos p
  JOIN clientes c ON c.id = p.cliente_id;

CREATE OR REPLACE DEFINER = 'root'@'localhost' SQL SECURITY DEFINER VIEW v_stock_bajo AS
SELECT pr.sku,
       pr.nombre AS producto,
       pr.stock,
       pv.nombre AS proveedor
  FROM productos pr
  JOIN proveedores pv ON pv.id = pr.proveedor_id
 WHERE pr.stock < 10;

-- Vista para la app móvil (solo catálogo, sin datos de clientes)
CREATE OR REPLACE DEFINER = 'root'@'localhost' SQL SECURITY DEFINER VIEW v_catalogo_movil AS
SELECT sku, nombre, categoria, precio, stock
  FROM productos;


-- =====================================================================
-- 5. TRIGGERS
-- =====================================================================
DELIMITER $$

-- Antes de insertar una línea: comprueba stock y copia el precio del producto
CREATE DEFINER = 'root'@'localhost' TRIGGER trg_lineas_bi
BEFORE INSERT ON lineas_pedido FOR EACH ROW
BEGIN
  DECLARE v_precio DECIMAL(10,2);
  DECLARE v_stock  INT;

  SELECT precio, stock INTO v_precio, v_stock
    FROM productos WHERE id = NEW.producto_id;

  IF v_stock IS NULL THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'El producto no existe';
  END IF;
  IF v_stock < NEW.cantidad THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Stock insuficiente';
  END IF;

  SET NEW.precio_unitario = v_precio;
END$$

-- Después de insertar una línea: descuenta el stock
CREATE DEFINER = 'root'@'localhost' TRIGGER trg_lineas_ai
AFTER INSERT ON lineas_pedido FOR EACH ROW
BEGIN
  UPDATE productos SET stock = stock - NEW.cantidad WHERE id = NEW.producto_id;
END$$

DELIMITER ;


